cabal-version:      3.0
name:               maze-haskell
version:            0.1.0.0

executable maze-haskell
    main-is:          Main.hs
    
    other-modules:
        MazeTypes
        MazeGenerator
        MazeDrawer
        MazeTester

    build-depends:
        base >= 4.14 && < 5,
        containers,
        random

    hs-source-dirs:   .
    default-language: Haskell2010